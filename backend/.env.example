DATABASE_URL="postgresql://autobody:autobody@localhost:5432/autobody?schema=public"
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"
PORT=4001
UPLOAD_DIR="uploads"
CORS_ORIGIN="http://localhost:5180"

# WebAuthn (Inventory fingerprint/passkey unlock) — both default to being
# derived from CORS_ORIGIN above, so these are only needed if the
# frontend's public origin differs from it (e.g. behind a reverse proxy).
# WEBAUTHN_RP_ID="localhost"
# WEBAUTHN_ORIGIN="http://localhost:5180"

# WhatsApp (Meta Cloud API) — leave blank to keep the console-log stub.
# Get these from Meta for Developers > your app > WhatsApp > API Setup.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION="v20.0"
# Country code (no +) used to expand locally-stored numbers like
# "0771234567" into international form ("94771234567").
WHATSAPP_DEFAULT_COUNTRY_CODE="94"
# Publicly-reachable backend URL — required for photos to actually render
# in WhatsApp (Meta fetches the image link). localhost only works for the
# stub path; use a tunnel (ngrok, etc.) or your real deployment's URL.
PUBLIC_BASE_URL="http://localhost:4001"

# Inventory → Import → PDF / photo: supplier bills are read by Claude.
# Get a key at https://console.anthropic.com/ (each scan is one request).
# CSV and Excel import work without it.
ANTHROPIC_API_KEY=

# Booking requests — link sent to customers to confirm their booking time
FRONTEND_URL=http://localhost:5180

# Email (Gmail): use an App Password (Google Account > Security > 2-Step Verification > App passwords)
# Leave empty to only log emails to the console.
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM="D & D Auto Spa <yourshop@gmail.com>"
